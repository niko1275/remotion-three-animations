{
  "name": "remotion-three-animations",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts Orbit out/orbit.mp4 --gl=angle",
    "render:efecto-foco": "remotion render src/index.ts EfectoFoco out/efecto-foco.mp4 --gl=swangle",
    "render:la-acusacion": "remotion render src/index.ts LaAcusacion out/la-acusacion.mp4 --gl=swangle",
    "render:el-experimento": "remotion render src/index.ts ElExperimento out/el-experimento.mp4 --gl=swangle",
    "render:la-trampa": "remotion render src/index.ts LaTrampa out/la-trampa.mp4 --gl=swangle",
    "render:el-falso-testigo": "remotion render src/index.ts ElFalsoTestigo out/el-falso-testigo.mp4 --gl=swangle",
    "render:el-falso-recuerdo": "remotion render src/index.ts ElFalsoRecuerdo out/el-falso-recuerdo.mp4 --gl=swangle",
    "render:los-resultados": "remotion render src/index.ts LosResultados out/los-resultados.mp4 --gl=swangle",
    "render:el-cierre": "remotion render src/index.ts ElCierre out/el-cierre.mp4 --gl=swangle",
    "render:hospital": "remotion render src/index.ts Hospital out/hospital.mp4 --gl=angle",
    "render:workshop": "remotion render src/index.ts Workshop out/workshop.mp4 --gl=angle",
    "still:hospital": "remotion still src/index.ts Hospital out/hospital.png --frame=90 --gl=angle",
    "still:workshop": "remotion still src/index.ts Workshop out/workshop.png --frame=90 --gl=angle",
    "render:hospital-story": "remotion render src/index.ts HospitalStory out/hospital-story.mp4 --gl=angle",
    "still:hospital-story": "remotion still src/index.ts HospitalStory out/hospital-story.png --frame=300 --gl=angle",
    "render:protagonist": "remotion render src/index.ts ProtagonistActions out/protagonist-actions.mp4 --gl=angle",
    "test:animations": "tsx --test tests/character-animations.test.ts",
    "still:graphic": "remotion still src/index.ts GraphicProtagonist out/graphic-protagonist.png --frame=30 --gl=angle",
    "render:graphic": "remotion render src/index.ts GraphicProtagonist out/graphic-protagonist.mp4 --gl=angle",
    "test:graphic": "node --test tests/graphic-asset.test.mjs",
    "voices": "tsx scripts/voices.ts",
    "test:voices": "tsx --test tests/voice-timing.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "music-metadata": "10.9.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
